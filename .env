# CreativeEnginePro 统一环境配置
# 融合：图片/视频/轮播 + 热点雷达 + TTS语音/译制/脚本生成
# ⚠️ 请替换为你的真实密钥

# ── LLM / DeepSeek ──
OPENAI_API_KEY="sk-your-deepseek-key"
OPENAI_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"

# ── TTS 语音引擎 (edge/elevenlabs/fish_audio/auto_lang/siliconflow/deepgram) ──
TTS_ENGINE="edge"

# ── ElevenLabs TTS (付费) ──
ELEVENLABS_API_KEY="sk-your-elevenlabs-key"

# ── Fish Audio TTS (付费) ──
FISH_AUDIO_KEY="your-fish-audio-key"

# ── 硅基流动 CosyVoice2 TTS (免费) ──
SILICONFLOW_KEY="sk-your-siliconflow-key"

# ── Deepgram TTS (免费) ──
DEEPGRAM_KEY="your-deepgram-key"

# ── YouTube Data API v3 ──
YOUTUBE_API_KEY="your-youtube-api-key"

# ── TMDB 电影数据库 ──
TMDB_API_KEY="your-tmdb-api-key"

# ── NewsAPI ──
NEWSAPI_KEY="your-newsapi-key"

# ── TrendMCP ──
TRENDMCP_KEY="your-trendmcp-key"
