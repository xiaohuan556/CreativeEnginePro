# Copy to deploy/.env.production and keep it out of Git.
STUDIO_DOMAIN=studio.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Creative Engine account and upload policy.
CEP_SESSION_COOKIE=cep_session
CEP_SESSION_DAYS=7
CEP_LOGIN_MAX_FAILURES=8
CEP_LOGIN_LOCK_MINUTES=20
CEP_BOOTSTRAP_ADMIN=admin
CEP_MAX_UPLOAD_MB=500
CEP_WORKER_POLL_SECONDS=1
CEP_TASK_LEASE_SECONDS=120

# Model providers. Leave unused providers empty; never put these values in web/.env files.
LLM_MODE=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
GPTIMAGE_MODEL=gpt-image-2
VEO_MODEL=veo-3.1-generate-preview
SEEDREAM_API_KEY=
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
# New desktop video nodes default to 2.5. Keep 2.0 allowed as an explicit
# per-task model when an older project needs its original limits/behaviour.
SEEDANCE_MODEL=doubao-seedance-2-5-260628
FISH_AUDIO_KEY=
ELEVENLABS_API_KEY=
SILICONFLOW_KEY=
DEEPGRAM_KEY=
