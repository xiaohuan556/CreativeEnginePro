CEP_DATABASE_URL=postgresql+psycopg://creative_engine:change-me@127.0.0.1:5432/creative_engine
CEP_PUBLIC_ORIGIN=https://studio.example.com
CEP_SESSION_COOKIE=cep_session
CEP_SESSION_DAYS=7
CEP_LOGIN_MAX_FAILURES=8
CEP_LOGIN_LOCK_MINUTES=20
CEP_DEFAULT_DAILY_TASKS=50
CEP_DEFAULT_DAILY_CREDITS=5000
CEP_DEFAULT_CONCURRENT_TASKS=2
CEP_BOOTSTRAP_ADMIN=admin
CEP_STORAGE_DIR=/var/lib/creative-engine/media
CEP_MAX_UPLOAD_MB=500
CEP_WORKER_POLL_SECONDS=1
